# App Config
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# AI Config
OLLAMA_BASE_URL= #url localhost ollama
OLLAMA_MODEL=gemma4:latest
MOCK_AI=false

# Database Config
MONGODB_URI= #url db mongodb

# Bitget API Config
BITGET_API_KEY= #key bitget
BITGET_SECRET_KEY= #secret key bitget
BITGET_PASSPHRASE= #passphrase bitget
BITGET_BASE_URL=https://api.bitget.com

# Trading Config
TRADING_MODE=PAPER #LIVE, PAPER
MAX_POSITIONS=1
MAX_TRADE_ALLOCATION=0.02 # 2% RULE: Maximum risk per trade (NEVER EXCEED)
MIN_TPSL_NOTIONAL=10 # minimum notional (USDT) - higher = lower fee impact percentage
BACKTEST_ITERATIONS=5
TRADING_STRATEGY=INTRADAY #SCALPING, INTRADAY, SWING
SCAN_MODE=HOT50 #VIP, HOT50, ALL

# Risk Management (2% RULE)
MAX_CONSECUTIVE_LOSS=8 # Number of consecutive losses before minimum sizing

# ═══════════════════════════════════════════════
# SCALPING PARAMETERS
# ═══════════════════════════════════════════════
SCALP_MAX_HOLD_MINUTES=10
SCALP_PROFIT_EXIT_MINUTES=5
SCALP_PROFIT_TARGET_PERCENT=0.5
SCALP_MAX_LOSS_PERCENT=0.3

# ═══════════════════════════════════════════════
# INTRADAY PARAMETERS (2-4 hours)
# ═══════════════════════════════════════════════
INTRADAY_MAX_HOLD_MINUTES=240 # 4 hours max
INTRADAY_PROFIT_EXIT_MINUTES=60 # 1 hour profit exit
INTRADAY_PROFIT_TARGET_PERCENT=2.0 # Target profit %
INTRADAY_MAX_LOSS_PERCENT=1.0 # Max loss % per trade

# ═══════════════════════════════════════════════
# SWING PARAMETERS (4-24 hours)
# ═══════════════════════════════════════════════
SWING_MAX_HOLD_MINUTES=1440 # 24 hours max
SWING_PROFIT_EXIT_MINUTES=240 # 4 hours profit exit
SWING_PROFIT_TARGET_PERCENT=5.0 # Target profit %
SWING_MAX_LOSS_PERCENT=2.0 # Max loss % per trade
