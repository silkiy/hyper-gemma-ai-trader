# App Config
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# AI Config
OLLAMA_BASE_URL= #url localhost ollama
OLLAMA_MODEL=gemma4:latest
MOCK_AI=false

# Database Config
MONGODB_URI= #url db mongodb

# Bitget API Config
BITGET_API_KEY= #key bitget
BITGET_SECRET_KEY= #secret key bitget
BITGET_PASSPHRASE= #passphrase bitget
BITGET_BASE_URL=https://api.bitget.com

# Trading Config
TRADING_MODE=PAPER #LIVE, PAPER
MAX_POSITIONS=1
MAX_TRADE_ALLOCATION=0.25 #0.0-1.0, persentase balance per trade
MIN_TPSL_NOTIONAL=10 #minimum notional (USDT) agar SL/TP bisa terpasang
TRADING_STRATEGY=SCALPING #SCALPING, INTRADAY, SWING
SCAN_MODE=ALL #VIP, HOT5, HOT20, HOT40, HOT60, HOT80, HOT100, ALL
