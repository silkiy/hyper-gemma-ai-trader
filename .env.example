# App Config
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# AI Config
OLLAMA_BASE_URL= #url localhost ollama
OLLAMA_MODEL=gemma4:latest
MOCK_AI=false

# Database Config
MONGODB_URI= #url db mongodb

# Bitget API Config
BITGET_API_KEY= #key bitget
BITGET_SECRET_KEY= #secret key bitget
BITGET_PASSPHRASE= #passphrase bitget
BITGET_BASE_URL=https://api.bitget.com

# Trading Config
TRADING_MODE=PAPER #LIVE, PAPER
MAX_POSITIONS=1
MAX_TRADE_ALLOCATION=0.20 #0.0-1.0, persentase balance per trade
MIN_TPSL_NOTIONAL=5 #minimum notional (USDT) agar SL/TP bisa terpasang
BACKTEST_ITERATIONS=5
TRADING_STRATEGY=SCALPING #SCALPING, INTRADAY, SWING
SCAN_MODE=ALL #VIP, HOT50, ALL

# Scalping Time Limits (Minutes)
SCALP_MAX_HOLD_MINUTES=10 # Hard force close limit regardless of PnL
SCALP_PROFIT_EXIT_MINUTES=5 # Force close if profitable after this time
SCALP_PROFIT_EXIT_USD=0.05 # Immediate TP in USD (Scalping only)
SCALP_MAX_LOSS_USD=0.03 # GLOBAL SHIELD: Immediate SL in USD (All strategies)
